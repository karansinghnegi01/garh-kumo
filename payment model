</style>
</head>
<body>

<div class="payment-wrap">
  <div class="payment-header">
    <h1>GarhKumo</h1>
    <p>Choose your preferred payment method</p>
  </div>

  <div class="payment-body">
    <div class="booking-summary">
      <strong>Booking Summary</strong>
      <div id="sumLines">Loading booking details...</div>
    </div>

    <div class="amount-box">
      <h2>Total Payment Amount</h2>
      <p id="paymentAmount">₹0</p>
    </div>

    <form id="paymentForm">
      <h3 class="section-title">Select Payment Method</h3>

      <div class="payment-options">
        <label class="payment-option">
          <input type="radio" name="paymentMethod" value="UPI" checked>
          <span>UPI</span>
          <small>GPay, PhonePe</small>
        </label>

        <label class="payment-option">
          <input type="radio" name="paymentMethod" value="Credit Card">
          <span>Credit Card</span>
          <small>Credit</small>
        </label>

        <label class="payment-option">
          <input type="radio" name="paymentMethod" value="Debit Card">
          <span>Debit Card</span>
          <small>Debit</small>
        </label>
      </div>

      <div id="upiFields" class="payment-fields active">
        <label for="upiId">UPI ID</label>
        <input
          type="text"
          id="upiId"
          placeholder="yourname@bank"
          autocomplete="off"
        >
        <p class="demo-note">Enter your UPI ID to continue.</p>
      </div>

      <div id="cardFields" class="payment-fields">
        <label for="cardHolder">Card Holder Name</label>
        <input
          type="text"
          id="cardHolder"
          placeholder="Name on card"
          autocomplete="cc-name"
        >

        <label for="cardNumber">Card Number</label>
        <input
          type="tel"
          id="cardNumber"
          placeholder="1234 5678 9012 3456"
          maxlength="19"
          inputmode="numeric"
          autocomplete="cc-number"
        >

        <div class="field-row">
          <div>
            <label for="expiry">Expiry Date</label>
            <input
              type="month"
              id="expiry"
              autocomplete="cc-exp"
            >
          </div>
          <div>
            <label for="cvv">CVV</label>
            <input
              type="password"
              id="cvv"
              placeholder="CVV"
              maxlength="4"
              inputmode="numeric"
              autocomplete="cc-csc"
            >
          </div>
        </div>
      </div>

      <button class="pay-btn" type="submit" id="payButton">
        Continue to UPI Payment
      </button>
    </form>

    <p class="demo-note">
      Demo payment interface. No actual money will be charged.
    </p>

    <p class="back-link">
      <a href="booking.html">← Back to booking form</a>
    </p>
  </div>
</div>

<script>
const bookingData = JSON.parse(
  localStorage.getItem("garhKumoBooking") || "{}"
);

const sumLines = document.getElementById("sumLines");
const paymentAmount = document.getElementById("paymentAmount");
const paymentForm = document.getElementById("paymentForm");
const payButton = document.getElementById("payButton");
const upiFields = document.getElementById("upiFields");
const cardFields = document.getElementById("cardFields");
const cardNumber = document.getElementById("cardNumber");
const cardHolder = document.getElementById("cardHolder");
const expiry = document.getElementById("expiry");
const cvv = document.getElementById("cvv");
const upiId = document.getElementById("upiId");

function escapeHTML(value) {
  return String(value ?? "").replace(/[&<>"']/g, function(char) {
    return {
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;"
    }[char];
  });
}

function formatDate(value) {
  if (!value) return "—";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return escapeHTML(value);
  }

  return escapeHTML(date.toLocaleDateString("en-IN", {
    day: "numeric",
    month: "long",
    year: "numeric"
  }));
}

sumLines.innerHTML =
  "<b>Destination:</b> " +
  escapeHTML(bookingData.destination || "—") +
  "<br><b>Package:</b> " +
  escapeHTML(bookingData.packageName || "—") +
  "<br><b>Name:</b> " +
  escapeHTML(bookingData.customerName || "—") +
  "<br><b>Guests:</b> " +
  escapeHTML(bookingData.guests || "—") +
  "<br><b>Travel Date:</b> " +
  formatDate(bookingData.travelDate);

const amount = Number(bookingData.packagePrice);

paymentAmount.textContent =
  "₹" + (
    Number.isFinite(amount) && amount >= 0
      ? amount.toLocaleString("en-IN")
      : "0"
  );

function selectedMethod() {
  return document.querySelector(
    'input[name="paymentMethod"]:checked'
  ).value;
}

function updatePaymentMethod() {
  const method = selectedMethod();
  const isUPI = method === "UPI";

  upiFields.classList.toggle("active", isUPI);
  cardFields.classList.toggle("active", !isUPI);

  upiId.required = isUPI;
  cardHolder.required = !isUPI;
  cardNumber.required = !isUPI;
  expiry.required = !isUPI;
  cvv.required = !isUPI;

  payButton.textContent =
    method === "UPI"
      ? "Continue to UPI Payment"
      : "Pay with " + method;
}

document.querySelectorAll(
  'input[name="paymentMethod"]'
).forEach(function(input) {
  input.addEventListener("change", updatePaymentMethod);
});

cardNumber.addEventListener("input", function() {
  const digits = this.value.replace(/\D/g, "").slice(0, 19);
  this.value = digits.replace(/(.{4})/g, "$1 ").trim();
});

cvv.addEventListener("input", function() {
  this.value = this.value.replace(/\D/g, "").slice(0, 4);
});

upiId.addEventListener("input", function() {
  this.value = this.value.trim();
});

function getPackageMessage(packageName, destination) {
  const place = (destination || "").toLowerCase();
  const pack = (packageName || "").toLowerCase();

  if (place.includes("kedarnath")) {
    return "Get ready for a spiritual journey to Kedarnath Dham!";
  }

  if (place.includes("badrinath")) {
    return "Your journey to the sacred Badrinath Temple awaits!";
  }

  if (place.includes("nainital")) {
    return "Get ready to explore the beautiful lakes and scenic views of Nainital!";
  }

  if (place.includes("chopta")) {
    return "Your Himalayan adventure to Chopta and Chandrashila awaits!";
  }

  if (place.includes("roopkund")) {
    return "Prepare for an unforgettable Himalayan trekking experience!";
  }

  if (pack.includes("family")) {
    return "Thank you for choosing our Family Package!";
  }

  if (pack.includes("adventure")) {
    return "Get ready for an exciting adventure with GarhKumo!";
  }

  if (pack.includes("luxury") || pack.includes("vip")) {
    return "Thank you for choosing our premium travel experience!";
  }

  return "Thank you for choosing GarhKumo. We look forward to your trip!";
}

paymentForm.addEventListener("submit", function(event) {
  event.preventDefault();

  if (!bookingData.destination ||
      !bookingData.packageName ||
      !bookingData.customerName ||
      !bookingData.travelDate ||
      !Number.isFinite(amount) ||
      amount <= 0) {
    alert("Booking details are incomplete. Please start your booking again.");
    return;
  }

  const method = selectedMethod();

  if (method === "UPI") {
    const upiPattern = /^[a-zA-Z0-9._-]{2,256}@[a-zA-Z0-9.-]{2,64}$/;

    if (!upiPattern.test(upiId.value.trim())) {
      alert("Please enter a valid UPI ID.");
      upiId.focus();
      return;
    }
  } else {
    const digits = cardNumber.value.replace(/\D/g, "");

    if (cardHolder.value.trim().length < 2) {
      alert("Please enter the cardholder name.");
      cardHolder.focus();
      return;
    }

    if (digits.length < 13 || digits.length > 19) {
      alert("Please enter a valid card number.");
      cardNumber.focus();
      return;
    }

    if (!expiry.value) {
      alert("Please select the card expiry date.");
      expiry.focus();
      return;
    }

    const selectedExpiry = new Date(expiry.value + "-01T00:00:00");
    const currentMonth = new Date();
    currentMonth.setDate(1);
    currentMonth.setHours(0, 0, 0, 0);

    if (selectedExpiry < currentMonth) {
      alert("This card has expired.");
      expiry.focus();
      return;
    }

    if (!/^\d{3,4}$/.test(cvv.value)) {
      alert("Please enter a valid CVV.");
      cvv.focus();
      return;
    }
  }

  const receiptId = "GK" +
    new Date().getFullYear() + "-" +
    Math.random().toString(36).substring(2, 8).toUpperCase();

  const receiptData = {
    receiptId: receiptId,
    paymentStatus: "Demo Only - Not Verified",
    paymentMethod: method,
    paymentDate: new Date().toLocaleString("en-IN"),
    customerName: bookingData.customerName || "",
    customerEmail: bookingData.customerEmail || "",
    customerPhone: bookingData.customerPhone || "",
    destination: bookingData.destination || "",
    packageName: bookingData.packageName || "",
    packageDays: bookingData.packageDays || "",
    packagePrice: amount,
    travelDate: bookingData.travelDate || "",
    guests: bookingData.guests || ""
  };

  try {
    localStorage.setItem(
      "garhKumoReceipt",
      JSON.stringify(receiptData)
    );

    const enquiries = JSON.parse(
      localStorage.getItem("enquiries") || "[]"
    );

    enquiries.push(receiptData);

    localStorage.setItem("enquiries", JSON.stringify(enquiries));
  } catch (error) {
    alert("Unable to save booking details in this browser.");
    return;
  }

  if (method === "UPI") {
    alert(
      "UPI details validated. This demo does not initiate a UPI payment or verify a transaction."
    );
  } else {
    alert(
      "Card details validated. This demo does not charge your card or verify a transaction."
    );
  }

  window.location.href = "booking_reicpt.html";
});

updatePaymentMethod();
</script>

</body>
</html>
