```html
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Payment — GarhKumo</title>
<style>
* {
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #f4f7fb;
  padding: 30px 15px;
  margin: 0;
}

.payment-wrap {
  max-width: 520px;
  margin: auto;
  background: #fff;
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(0,0,0,.1);
}

.payment-header {
  background: linear-gradient(135deg,#0f766e,#0ea5a4);
  color: white;
  padding: 24px 28px;
}

.payment-header h1 {
  margin: 0;
  font-size: 26px;
}

.payment-header p {
  margin: 6px 0 0;
  font-size: 14px;
}

.payment-body {
  padding: 28px;
}

.booking-summary {
  background: #f0fdf4;
  border: 1px solid #86efac;
  border-radius: 10px;
  padding: 14px 18px;
  margin-bottom: 22px;
  font-size: 14px;
  color: #14532d;
  line-height: 1.9;
  overflow-wrap: anywhere;
}

.booking-summary strong {
  display: block;
  font-size: 15px;
  margin-bottom: 6px;
}

.amount-box {
  background: #0f766e;
  color: white;
  padding: 15px;
  border-radius: 10px;
  margin-bottom: 22px;
  text-align: center;
}

.amount-box h2 {
  margin: 0;
  font-size: 18px;
}

.amount-box p {
  font-size: 32px;
  margin: 8px 0 0;
  font-weight: bold;
}

.section-title {
  font-size: 16px;
  margin-bottom: 12px;
}

.payment-options {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 9px;
  margin-bottom: 20px;
}

.payment-option {
  border: 1px solid #cbd5e1;
  border-radius: 10px;
  padding: 13px 5px;
  text-align: center;
  cursor: pointer;
  font-size: 13px;
  background: #fff;
  transition: .2s;
}

.payment-option input {
  accent-color: #0f766e;
  margin: 0 0 8px;
}

.payment-option span {
  display: block;
  font-weight: bold;
}

.payment-option:has(input:checked) {
  border: 2px solid #0f766e;
  background: #f0fdfa;
}

label {
  display: block;
  font-size: 13px;
  color: #475569;
  margin: 14px 0 5px;
}

input[type="text"],
input[type="password"],
input[type="month"],
input[type="tel"] {
  width: 100%;
  padding: 12px;
  border: 1px solid #cbd5e1;
  border-radius: 8px;
